# SMTP / Mailer
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=ProoTech Platform

# Core API
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/whatsapp-otp-platform
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
APP_PUBLIC_URL=http://localhost:4000
SWAGGER_ENABLED=true
SWAGGER_BASIC_AUTH_USER=waotpdocs
SWAGGER_BASIC_AUTH_PASSWORD=replace-with-a-strong-docs-password-without-hash
TRUST_PROXY=1

# Dashboard / CORS
DASHBOARD_ORIGIN=http://localhost:5173
LANDING_ORIGIN=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://whatsapp-otp.prootech-agency.com

# Platform owner seed
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# Optional support demo seed
SUPPORT_DEMO_NAME=Support Demo Company
SUPPORT_DEMO_SLUG=support-demo
SUPPORT_DEMO_CONTACT_EMAIL=owner@support-demo.local
SUPPORT_ADMIN_EMAIL=support-admin@example.com
SUPPORT_ADMIN_PASSWORD=SupportAdmin123!
SUPPORT_SUPERVISOR_EMAIL=support-supervisor@example.com
SUPPORT_SUPERVISOR_PASSWORD=SupportSupervisor123!
SUPPORT_AGENT_EMAIL=support-agent@example.com
SUPPORT_AGENT_PASSWORD=SupportAgent123!
