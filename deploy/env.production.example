# Copy to apps/api/.env on the server and fill in. Never commit the real file.

# ── Core ────────────────────────────────────────────────────────────────────
PORT=4000
# Same Atlas connection string as before — all existing data lives there.
# Rotate this password in Atlas after the move.
MONGODB_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/whatsapp-otp-platform
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=12h
APP_PUBLIC_URL=https://api.your-domain.com
TRUST_PROXY=1

# ── Dashboard / CORS ────────────────────────────────────────────────────────
DASHBOARD_ORIGIN=https://dashboard.your-domain.com
CORS_ALLOWED_ORIGINS=https://dashboard.your-domain.com

# ── WhatsApp (Chromium) ─────────────────────────────────────────────────────
# Printed at the end of vps-setup.sh — usually /usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Memory savings. Raise the heap if sessions misbehave; set blocking to false to debug.
WA_CHROME_HEAP_MB=256
WA_BLOCK_PAGE_MEDIA=true
# Watchdog: how often to verify every session is really alive (ms).
WA_WATCHDOG_INTERVAL_MS=60000
# Idle hibernation — OTP-only tenants ONLY. Comma-separated tenant ids; empty = disabled.
# A hibernated tenant releases its Chrome and restarts automatically on the next send
# (first send after hibernation takes ~20-40s). NEVER list a tenant that uses the inbox.
WA_HIBERNATE_TENANTS=
WA_IDLE_HIBERNATE_MINUTES=60

# ── Tuning ──────────────────────────────────────────────────────────────────
# Safety-net reconciliation with WhatsApp (ms). Higher = less CPU.
SUPPORT_SYNC_INTERVAL_MS=120000
TENANT_CACHE_TTL_MS=30000
API_KEY_CACHE_TTL_MS=60000
# Auto-delete OTP records older than N days. 0 = keep forever (default).
OTP_RETENTION_DAYS=0

# ── AI auto-reply (optional) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
SUPPORT_AI_MODEL=claude-opus-5

# ── Swagger ─────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_BASIC_AUTH_USER=waotpdocs
SWAGGER_BASIC_AUTH_PASSWORD=set-a-strong-password

# ── Mail ────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Wathqly
